# =================================================================================
# 1. CORE GCP CONFIGURATION
# =================================================================================
PROJECT_ID="<YOUR_PROJECT_ID>"
REGION=us-central1

# Google SDK variables (exported for Python subprocesses)
export GOOGLE_GENAI_USE_VERTEXAI=True
export GOOGLE_CLOUD_PROJECT="${PROJECT_ID}"
# Model endpoint, NOT the infra region: gemini-3.x is served from the
# global endpoint only. Infra (BQ, Cloud Run) keeps using REGION.
export GOOGLE_CLOUD_LOCATION="global"

# =================================================================================
# 2. BIGQUERY AGENT ANALYTICS
# =================================================================================
DATASET_ID="agent_logs"
DATASET_LOCATION="us-central1"
TABLE_ID="agent_events"
TEST_DATASET_ID="agent_logs_test"

# =================================================================================
# 3. KNOWLEDGE SUPERVISOR (Agent Engine)
# =================================================================================
SUPERVISOR_MODEL_ID="gemini-3.5-flash"
MODEL_LOCATION="global"

# Model selection (one place; GA gemini-3.x served from the global endpoint)
EVAL_MODEL_ID="gemini-3.5-flash"          # local traffic agents (supervisor + specialists)
EVOLUTION_MODEL_ID="gemini-3.5-flash"     # analyst fleet + candidate consolidation
SKILL_EVOLUTION_MODEL_ID="gemini-3.5-flash"  # the evolution ADK agent itself
TOPIC_RESOLVER_MODEL="gemini-3.5-flash"   # semantic topic resolution in policy/benefits tools
SUPERVISOR_REGION="${REGION}"
SUPERVISOR_DISPLAY_NAME="knowledge-supervisor"

# =================================================================================
# 4. POLICY AGENT (Cloud Run A2A)
# =================================================================================
POLICY_AGENT_SERVICE_NAME="policy-agent"
POLICY_AGENT_MODEL_ID="gemini-3.5-flash"

# =================================================================================
# 5. HR CALCULATOR (Cloud Run A2A)
# =================================================================================
HR_CALCULATOR_SERVICE_NAME="hr-calculator"
HR_CALCULATOR_MODEL_ID="gemini-3.5-flash"

# =================================================================================
# 5b. BENEFITS AGENT (Cloud Run A2A)
# =================================================================================
BENEFITS_AGENT_SERVICE_NAME="benefits-agent"
BENEFITS_AGENT_MODEL_ID="gemini-3.5-flash"

# =================================================================================
# 6. LOAD TEST / EVAL CONFIGURATION
# =================================================================================
TOPICS_CONFIG="pto:10,benefits:10,expenses:10,holidays:10,sick_leave:10"
CONCURRENCY=10
DURATION_MINUTES=50

# =================================================================================
# 7. AGENT VERSION TAGGING
# =================================================================================
# Agent version tag — written to BQ custom_tags for version-aware filtering.
# All enterprise agents and workflow agents read this variable.
# Quality agent uses it to filter BQ sessions and tag GitHub issues.
#
# When unset, agents fall back to SKILL.md frontmatter metadata.version.
# This is the recommended default for demos — the version travels with the
# skill and bumps automatically on evolution.
# Set explicitly in deploy scripts or CI to override.
# AGENT_VERSION=0

# =================================================================================
# 8. PROMPT MODE (default)
# =================================================================================
# Controls how agents load their prompt instructions.
#   skill-evolution  — load from skill/SKILL.md (default, supports evolution)
#   reactive-loop    — load from Vertex AI Prompt Manager or local prompts.py
PROMPT_MODE=skill-evolution

# GCS bucket for archiving evolution run data (quality reports, skill snapshots, etc.)
# Created by: bash scripts/setup/setup_gcp.sh
GCS_BUCKET=${PROJECT_ID}-skill-evolution

# Whether to upload run data to GCS after evolution. Default: false (local).
# deploy.sh sets this to true for Cloud Run Jobs.
GCS_UPLOAD=false

# =================================================================================
# 9. PR CREATION (Skill Evolution)
# =================================================================================
# PRs are created via Antigravity CLI (agy). Install:
#   curl -fsSL https://antigravity.google/cli/install.sh | bash
# Base branch for evolution PRs (default: "main").
GITHUB_BASE_BRANCH="main"

# =================================================================================
# 10. BIGQUERY AGENT ANALYTICS SDK
# =================================================================================
# Root of the cloned BigQuery-Agent-Analytics-SDK repo (used for quality scoring).
# If unset, ensure_sdk.py auto-clones into .sdk/ on first use.
# SDK_DIR=/path/to/BigQuery-Agent-Analytics-SDK
SDK_REPO="https://github.com/evekhm/BigQuery-Agent-Analytics-SDK.git"
SDK_BRANCH="fix/md-scorecards"
